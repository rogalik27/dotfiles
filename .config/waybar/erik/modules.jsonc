{
  "upower": {
    "tooltip": true,
    "on-click": "/home/mivanchenko/.local/bin/swaysettings -p power"
  },
  "custom/caffeine": {
    "exec": "~/.config/waybar/scripts/caffeine.sh",
    "return-type": "json",
    "interval": 5,
    "signal": 10,
    "format": "{}",
    "tooltip": true,
    "on-click": "~/.config/waybar/scripts/caffeine.sh toggle"
  },
  "sway/workspaces": {
    "disable-scroll-wraparound": true,
    "disable-scroll": false,
    "all-outputs": false,
    "enable-bar-scroll": true,
    "format": "{value}"
  },
  "hyprland/workspaces": {
    "sort-by-number": true,
    "disable-scroll-wraparound": true,
    "disable-scroll": false,
    "all-outputs": false,
    "enable-bar-scroll": true,
    "format": "{name}"
  },
  "sway/mode": {
    "format": "{}"
  },
  "tray": {
    "reverse-direction": true,
    "icon-size": 24,
    "spacing": 10
  },
  "clock": {
    "interval": 1,
    "format": "{:%a %d %b %H:%M:%S}",
    "tooltip": false,
    "on-click": "swaync-client -t -sw"
  },
  "cpu": {
    "format": "󰻠 {usage}%",
    "interval": 1
  },
  "memory": {
    "interval": 10,
    "format": " {used:0.2f} GiB"
  },
  "custom/media": {
    "escape": true,
    "format": " {icon}{text}",
    "return-type": "json",
    "format-icons": {
      "Playing": " ",
      "Paused": " "
    },
    "max-length": 35,
    "exec": "playerctl metadata --format '{\"text\": \"{{title}}\", \"tooltip\": \"{{playerName}} : {{title}}\", \"alt\": \"{{status}}\", \"class\": \"{{status}}\"}' -F",
    "on-click": "playerctl play-pause"
  },
  "privacy": {
    "icon-spacing": 2,
    "icon-size": 16,
    "modules": [
      {
        "type": "screenshare"
      },
      {
          "type": "audio-out"
      },
      {
        "type": "audio-in"
      }
    ]
  },
  "gamemode": {
    "tooltip": true,
    "format": "{glyph}",
    "format-alt": "{glyph} {count}",
    "glyph": "",
    "not-running-hide": true,
    "use-icon": true,
    "icon-name": "input-gaming-symbolic",
    "icon-spacing": 6
  },
  "custom/airplane": {
    "tooltip": false,
    "format": "{icon}",
    "return-type": "json",
    "max-length": 70,
    "interval": "once",
    "format-icons": {
      "disabled": "<span foreground='#928374'>✈</span>",
      "enabled": " ✈ "
    },
    "exec": "~/.config/waybar/scripts/airplaneMode.sh",
    "on-click": "~/.config/waybar/scripts/airplaneMode.sh --toggle",
    "signal": 8,
    "escape": true
  },
  "bluetooth": {
    "format": "󰂲",
    "format-off": "󰂲",
    "format-on": "󰂯",
    "format-connected": "󰂱 {num_connections}",
    "format-connected-battery": "󰂱 {num_connections}",

    "tooltip-format": "{controller_alias}\t{controller_address}\n\n{num_connections} connected",
    "tooltip-format-connected": "{controller_alias}\t{controller_address}\n\n{num_connections} connected\n\n{device_enumerate}",
    "tooltip-format-enumerate-connected": "{device_alias}\t{device_address}",
    "tooltip-format-enumerate-connected-battery": "{device_alias}\t{device_address}\t{device_battery_percentage}%",

    "on-click": "/home/mivanchenko/.local/bin/swaysettings -p bluetooth"
  },
  "custom/bt-battery": {
    "exec": "python3 ~/.config/waybar/scripts/bt_battery.py",
    "return-type": "json",
    "interval": 5,
    "signal": 9,
    "tooltip": true,
    "escape": false,
    "on-click": "pkill -RTMIN+9 waybar"
  },
  "network#wifi": {
    "interface": "wl*",
    "interval": 30,
    "format": "{icon}",
    "format-wifi": "{icon}",
    "format-linked": "",
    "format-disconnected": "",
    "format-disabled": "",
    "format-icons": [
      "󰤯",
      "󰤟",
      "󰤢",
      "󰤥",
      "󰤨"
    ],
    "on-click": "alacritty -e nmtui",
    "on-click-right": "wifi toggle",
    "tooltip-format": "{}",
    "tooltip-format-wifi": "{essid} ({signalStrength}%)\n{ipaddr}/{cidr}"
  },
  "network#ethernet": {
    "interface": "enp*",
    "interval": 30,
    "format-ethernet": "",
    "format-linked": "",
    "format-disconnected": "",
    "format-disabled": "",
    "on-click": "alacritty -e nmtui",
    "tooltip-format": "Ethernet not connected",
    "tooltip-format-ethernet": "{ifname}: {ipaddr}/{cidr}"
  },
  "pulseaudio": {
    "format": "{icon} {volume}%",
    "format-icons": {
        "default-muted": "",
        "bluetooth": "",
        "headphones": "",
        "headset": "",
        "phone": "",
        "phone-muted": "",
        "portable": "",
        "car": "",
        "default": ["", "", ""]
    },
    "max-volume": 100,
    "on-click": "pavucontrol"
  },
  "custom/wallpaperRefresh": {
    "exec": "echo '  '",
    "tooltip": false,
    "on-click": "~/.config/sway/scripts/randomWallpaper.sh --click",
    "escape": true
  },
  "custom/headsetcontrol": {
    "interval": 60,
    "tooltip": false,
    "exec": "~/.config/waybar/scripts/headsetcontrol.sh",
    "exec-if": "which headsetcontrol",
    "format": "{}",
    "escape": true
  },
  "custom/ArchUpdates": {
    "interval": 600,
    "tooltip": false,
    "signal": 9,
    "exec": "~/.config/waybar/scripts/check-for-updates.sh",
    "on-click": "kitty -e $SHELL -c '~/.config/waybar/scripts/update_system.sh'; pkill -SIGRTMIN+9 waybar",
    "escape": true
  },
  "custom/weather": {
    "format": "<span font_family='Weather Icons'>{icon}</span> {text}",
    "format-icons": {
      "no-connection": "",
      "error": "",
      "loading": "",
      "01d": "",
      "01n": "",
      "02d": "",
      "02n": "",
      "03d": "",
      "03n": "",
      "04d": "",
      "04n": "",
      "09d": "",
      "09n": "",
      "10d": "",
      "10n": "",
      "11d": "",
      "11n": "",
      "13d": "",
      "13n": "",
      "50d": "",
      "50n": ""
    },
    "tooltip": true,
    "restart-interval": 10,
    "exec": "python ~/.config/waybar/scripts/openWeatherMap.py",
    "return-type": "json"
  }
}
