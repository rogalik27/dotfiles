    #     statusline #ffffff
    #     background #323232
    #     inactive_workspace #32323200 #32323200 #5c5c5c
    # }
}

client.focused          #4a4a4a #5a5a5a #ffffff #b8b8b8 #4a4a4a
client.focused_inactive #555555 #2b2b2b #d0d0d0 #555555 #555555
client.unfocused        #3a3a3a #1f1f1f #bdbdbd #3a3a3a #1f1f1f
client.urgent           #a33a3a #7a1f1f #ffffff #a33a3a #7a1f1f

font pango:Cantarell 12


# Center all floating windows on open to prevent off-screen positioning
for_window [floating] move position center

# Wayland apps
for_window [app_id="org.gnome.World.PikaBackup"] floating enable, move workspace current, focus
for_window [app_id="org.gnome.Nautilus"] move workspace current, focus
for_window [app_id="pavucontrol"] floating enable
for_window [app_id="org.gnome.Calculator"] floating enable
for_window [app_id="yubico.com.yubioath-desktop"] floating enable, resize set 300 700, move position center


# Xwayland apps
for_window [app_id="pavucontrol"] floating enable, resize set 900 700, move position center
for_window [app_id="evolution-alarm-notify"] floating enable, resize set 900 300, move position center


default_border none
default_floating_border none

include /etc/sway/config.d/*
