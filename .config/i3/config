# i3 config translated from the provided Sway config
# Original Sway config path context: /home/mivanchenko/.config/sway/
#
# Notes:
# - Sway/Wayland-only commands were replaced with X11/i3 equivalents where practical.
# - Touchpad and window matching under X11 may need checking with `xinput list` and `xprop`.
# - Optional helper tools used below: dunst, xss-lock, i3lock, maim, xclip, clipmenu, clipmenud.
# Hide window title bars
default_border pixel 1
default_floating_border pixel 1

# Force it for all new windows, useful on newer i3 versions
for_window [class="^.*"] border pixel 1

### Variables
set $mod Mod4
set $left h
set $down j
set $up k
set $right l
set $term alacritty
set $menu rofi -show drun -show-icons
set $sway_config_dir /home/mivanchenko/.config/sway

# i3 include replacement. Keep commented if the directory does not exist on your system.
# include /etc/i3/config-vars.d/*

### Startup / session utilities

# Sway: exec mako
# X11/i3 replacement:
exec --no-startup-id dunst

# Sway idle/lock replacement.
# Locks after the X screensaver timeout and locks before suspend via logind.
exec --no-startup-id xset s 300 5
exec --no-startup-id xset dpms 600 600 600
exec --no-startup-id xss-lock --transfer-sleep-lock -- i3lock -c 000000

### Input configuration

# Sway input replacement for keyboard layout/options.
# Keyboard layout: German + US, switch with Alt+Shift
# Clears old XKB options first, so Caps Lock is no longer Escape.
exec_always --no-startup-id setxkbmap -layout de,us -option '' -option 'grp:alt_shift_toggle'

# Sway had: bindsym $mod+Shift_L input type:keyboard xkb_switch_layout next
# i3 cannot switch XKB layouts natively. Install `xkb-switch` for this binding,
# or use the commented setxkbmap variant below for a pure-XKB shortcut.
bindsym $mod+Shift_L exec --no-startup-id xkb-switch -n
# Alternative without xkb-switch, but it may interfere with Mod+Shift shortcuts:
# exec --no-startup-id setxkbmap -layout de,ua -option grp:win_shift_toggle,caps:escape

# Touchpad replacement for Sway input block.
# Device/property names can differ under X11. Check with `xinput list` and `xinput list-props <device>`.
exec --no-startup-id xinput --set-prop "ELAN06C6:00 04F3:3193 Touchpad" "libinput Tapping Enabled" 1
exec --no-startup-id xinput --set-prop "ELAN06C6:00 04F3:3193 Touchpad" "libinput Natural Scrolling Enabled" 0
# Usually tuple format is: two-finger, edge, button. Leave commented until verified on your system.
# exec --no-startup-id xinput --set-prop "ELAN06C6:00 04F3:3193 Touchpad" "libinput Scroll Method Enabled" 1 0 0

### Key bindings

# Start a terminal
bindsym $mod+Return exec --no-startup-id $term

# Kill focused window
bindsym $mod+q kill

# Start launcher
bindsym $mod+d exec --no-startup-id $menu

# Drag floating windows with $mod + left mouse; resize with $mod + right mouse.
floating_modifier $mod

# Reload config
bindsym $mod+Shift+c reload

# Exit i3
bindsym $mod+Shift+e exec --no-startup-id "i3-nagbar -t warning -m 'You pressed the exit shortcut. Do you really want to exit i3? This will end your X11 session.' -B 'Yes, exit i3' 'i3-msg exit'"

