### Window rules

# Sway used app_id; i3 on X11 uses WM_CLASS, inspect with `xprop`.
for_window [class="(?i)pavucontrol"] floating enable, resize set 900 700, move position center
for_window [class="(?i)org.gnome.Calculator|gnome-calculator|calculator"] floating enable
for_window [class="(?i)yubico|yubioath"] floating enable, resize set 300 700, move position center
for_window [class="(?i)evolution-alarm-notify"] floating enable, resize set 900 300, move position center

